<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Kisan Mitra (किसान मित्र) - Specialist Tomato & Potato Plant Doctor" %></title>
  <meta name="description" content="<%= metaDescription || 'Kisan Mitra is a PhD-grade AI plant pathology platform exclusively for Tomato and Potato leaf & tuber diagnosis.' %>">

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/static/css/style.css?v=6">
</head>
<body class="agri-glass-app">

  <!-- Botanical Ambient Canvas (Gives glass surfaces rich refraction & depth) -->
  <div class="ambient-canvas" aria-hidden="true">
    <div class="bloom bloom-emerald"></div>
    <div class="bloom bloom-amber"></div>
    <div class="bloom bloom-sky"></div>
    <div class="canvas-grain"></div>
  </div>

  <!-- Floating Glass Navigation Bar -->
  <header class="glass-navbar">
    <div class="container nav-inner">
      <a href="/" class="brand" id="brand-link">
        <div class="brand-crest" aria-hidden="true">🌿</div>
        <div class="brand-copy">
          <div class="brand-title-row">
            <h1 id="brand-title" class="brand-name" data-i18n="app_title">Kisan Mitra</h1>
            <span class="brand-hindi-pill">किसान मित्र</span>
          </div>
          <span class="brand-role" data-i18n="app_subtitle">Specialist Tomato &amp; Potato Plant Doctor</span>
        </div>
      </a>

      <div class="nav-controls">
        <!-- Strictly 2 Languages: English & Hindi -->
        <div class="lang-segmented" role="group" aria-label="Language selection">
          <button id="lang-btn-en" class="lang-option active" type="button" aria-pressed="true">English</button>
          <button id="lang-btn-hi" class="lang-option" type="button" aria-pressed="false">हिन्दी</button>
        </div>

        <!-- Kisan Helpline Modal Trigger -->
        <button id="btn-nav-chat" class="btn-glass-helpline" type="button">
          <span aria-hidden="true">💬</span>
          <span data-i18n="btn_chat_nav">Kisan Helpline</span>
        </button>
      </div>
    </div>
  </header>

  <main class="container page-shell">
    <!-- Hero Editorial Header -->
    <section class="hero-panel glass-surface">
      <div class="hero-eyebrow-row">
        <span class="badge-glass badge-emerald">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-i18n="trust_badge">ICAR Pathology &amp; Meta DINOv2 AI</span>
        </span>
        <span class="badge-glass badge-amber">
          <span aria-hidden="true">🎯</span>
          <span data-i18n="conditions_count_badge">43 Tomato &amp; Potato Conditions</span>
        </span>
        <span class="badge-glass badge-blue">
          <span aria-hidden="true">⚡</span>
          <span data-i18n="sprayer_badge">15L Knapsack Sprayer Dosages</span>
        </span>
      </div>

      <h2 class="hero-headline" data-i18n="tagline">
        PhD-Grade Plant Pathology &amp; AI Crop Doctor
      </h2>
      <p class="hero-subheadline" data-i18n="sub_tagline">
        Upload or photograph any tomato or potato leaf, stem, or tuber for instant differential diagnosis, epidemiology triggers, organic remedies, and exact 15-Liter sprayer formulations.
      </p>
    </section>

    <!-- Primary Two-Column Glass Workspace -->
    <div class="workspace-grid">

      <!-- Left Column: Step 1 — Capture & Upload -->
      <section class="glass-panel card-capture" id="card-capture" aria-labelledby="step-1-heading">
        <div class="panel-header">
          <div class="step-pill" aria-hidden="true">1</div>
          <div class="panel-heading-group">
            <h3 id="step-1-heading" class="panel-title" data-i18n="step_1_title">Select Crop &amp; Upload Leaf Photo</h3>
            <p class="panel-subtitle" data-i18n="step_1_desc">Take a clear daylight photo of the affected leaf, stem, or potato tuber.</p>
          </div>
        </div>

        <div class="panel-body">
          <!-- Crop Selector -->
          <div class="control-block">
            <label for="crop-select" class="control-label" data-i18n="crop_focus_label">
              🌱 Crop Focus
            </label>
            <div class="crop-selector-grid" role="group" aria-label="Select crop">
              <button type="button" class="crop-btn active" data-crop="Auto" aria-pressed="true">
                <span aria-hidden="true">🌾</span>
                <span data-i18n="crop_auto">Auto-Detect</span>
              </button>
              <button type="button" class="crop-btn" data-crop="Tomato" aria-pressed="false">
                <span aria-hidden="true">🍅</span>
                <span data-i18n="crop_tomato">Tomato (टमाटर)</span>
              </button>
              <button type="button" class="crop-btn" data-crop="Potato" aria-pressed="false">
                <span aria-hidden="true">🥔</span>
                <span data-i18n="crop_potato">Potato (आलू)</span>
              </button>
            </div>
            <select id="crop-select" hidden aria-hidden="true">
              <option value="Auto" selected>Auto</option>
              <option value="Tomato">Tomato</option>
              <option value="Potato">Potato</option>
            </select>
          </div>

          <!-- Capture Mode Switch -->
          <div class="mode-switch-bar" role="tablist" aria-label="Capture mode">
            <button id="tab-mode-upload" class="mode-tab active" type="button" role="tab" aria-selected="true">
              <span aria-hidden="true">📁</span>
              <span data-i18n="btn_upload_mode">Upload Photo</span>
            </button>
            <button id="tab-mode-camera" class="mode-tab" type="button" role="tab" aria-selected="false">
              <span aria-hidden="true">📷</span>
              <span data-i18n="btn_camera_mode">Live Camera</span>
            </button>
          </div>

          <!-- Dropzone Upload -->
          <div id="dropzone-section">
            <div id="dropzone" class="glass-dropzone" tabindex="0" role="button" aria-label="Upload leaf or tuber image">
              <div class="dropzone-emblem" aria-hidden="true">🍃</div>
              <p class="dropzone-title" data-i18n="dropzone_text">Click or drag &amp; drop leaf or tuber photo</p>
              <p class="dropzone-note" data-i18n="dropzone_hint">Supports JPG, PNG, WebP • Best results in natural daylight</p>
              <span class="dropzone-cta" data-i18n="btn_browse">Choose Photo</span>
              <input type="file" id="file-input" accept="image/*" capture="environment">
            </div>
          </div>

          <!-- Live Camera Section -->
          <div id="camera-section" style="display: none;">
            <div class="camera-frame">
              <video id="camera-video" playsinline autoplay muted></video>
              <div id="camera-guide" class="camera-reticle-overlay" style="display: none;">
                <div class="scan-line"></div>
              </div>
            </div>
            <div class="camera-btn-row">
              <button id="btn-snap-photo" class="btn-primary-glass btn-snap" type="button">
                <span aria-hidden="true">📸</span>
                <span data-i18n="btn_snap">Take Photo</span>
              </button>
              <button id="btn-switch-camera" class="btn-secondary-glass" type="button">
                <span aria-hidden="true">🔄</span>
                <span data-i18n="btn_flip">Flip</span>
              </button>
            </div>
          </div>

          <!-- Uploaded Image Preview -->
          <div id="preview-container" class="preview-frame" style="display: none;">
            <img id="image-preview" alt="Selected crop photo preview">
            <button id="btn-remove-preview" class="btn-overlay-reset" type="button">
              ✕ <span data-i18n="btn_remove_preview">Change Photo</span>
            </button>
          </div>

          <!-- Diagnose CTA -->
          <button id="btn-diagnose" class="btn-primary-glass btn-diagnose-full" disabled type="button">
            <span aria-hidden="true">🔍</span>
            <span data-i18n="btn_diagnose">Diagnose Crop Health</span>
          </button>

          <!-- Clean Field Photography Tip -->
          <div class="glass-field-note">
            <span class="note-icon" aria-hidden="true">💡</span>
            <p data-i18n="photo_tip_copy"><strong>Field Tip:</strong> Hold the camera 15–25 cm from a single symptomatic leaf or cut tuber so concentric rings, fungal fuzz, or spots are sharply focused.</p>
          </div>
        </div>
      </section>

      <!-- Right Column: Step 2 — PhD Diagnosis & Prescription Dashboard -->
      <section class="glass-panel card-diagnosis" id="card-results" aria-labelledby="step-2-heading">
        <div class="panel-header">
          <div class="step-pill step-emerald" aria-hidden="true">2</div>
          <div class="panel-heading-group">
            <h3 id="step-2-heading" class="panel-title" data-i18n="step_2_title">Expert Pathology &amp; Field Prescription</h3>
            <p class="panel-subtitle" data-i18n="step_2_desc">Differential diagnosis, causal organism taxonomy, and exact sprayer recipes.</p>
          </div>
        </div>

        <div class="panel-body diagnosis-body">

          <!-- Standby State -->
          <div id="empty-state" class="standby-view">
            <div class="standby-crest" aria-hidden="true">🔬</div>
            <h4 class="standby-title" data-i18n="empty_title">Diagnostic Engine Ready</h4>
            <p class="standby-subtitle" data-i18n="empty_desc">Upload a photo of your tomato or potato leaf, stem, or tuber on the left to generate a complete plant pathology report.</p>

            <div class="capability-cards">
              <div class="capability-tile">
                <span class="cap-icon" aria-hidden="true">🧬</span>
                <div>
                  <strong data-i18n="cap_1_title">PhD Differential Pathology</strong>
                  <p data-i18n="cap_1_desc">Separates Early Blight concentric rings, Late Blight abaxial sporangia, Septoria pycnidia, Bacterial specks, and Tuber Pink Rot.</p>
                </div>
              </div>
              <div class="capability-tile">
                <span class="cap-icon" aria-hidden="true">🧪</span>
                <div>
                  <strong data-i18n="cap_2_title">15L Knapsack Pump Recipes</strong>
                  <p data-i18n="cap_2_desc">Verified active ingredients, slurry mixing instructions, organic bio-controls, and spraying intervals.</p>
                </div>
              </div>
              <div class="capability-tile">
                <span class="cap-icon" aria-hidden="true">🔊</span>
                <div>
                  <strong data-i18n="cap_3_title">English &amp; Hindi Voice + WhatsApp</strong>
                  <p data-i18n="cap_3_desc">One-tap spoken advisory in clear Hindi or English and shareable prescription cards.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Loading State -->
          <div id="loading-state" class="standby-view" style="display: none;">
            <div class="standby-crest pulse-scan" aria-hidden="true">🌱</div>
            <h4 class="standby-title" data-i18n="loading_title">Running Deep Vision Pathology Scan...</h4>
            <p class="standby-subtitle" data-i18n="loading_desc">Extracting 768-dim DINOv2 cellular embeddings, necrotic speck topology, and foliar chlorosis index.</p>
          </div>

          <!-- Active Diagnosis Result -->
          <div id="result-details" style="display: none;">

            <!-- Result Hero Header -->
            <div class="result-summary-card">
              <div class="result-identity">
                <div class="result-tags-row">
                  <span class="crop-pill-badge" id="disease-crop-badge">TOMATO</span>
                  <span id="severity-badge" class="severity-pill-badge">⚠️ High Severity</span>
                </div>
                <h2 id="disease-name" class="result-title-en">Tomato Early Blight</h2>
                <div id="disease-hindi" class="result-title-hi">टमाटर का अगेती झुलसा रोग</div>
                <div id="disease-pathogen" class="result-pathogen">Alternaria solani (Fungus)</div>
              </div>

              <div class="confidence-gauge-card">
                <span class="gauge-caption" data-i18n="match_confidence">Match Accuracy</span>
                <span id="confidence-text" class="gauge-number">98.6%</span>
              </div>
            </div>

            <!-- Farmer Quick Actions -->
            <div class="prescription-actions">
              <button id="btn-voice-read" class="action-pill-btn btn-voice" type="button">
                <span aria-hidden="true">🔊</span>
                <span data-i18n="btn_listen">Listen (Audio)</span>
              </button>
              <button id="btn-whatsapp" class="action-pill-btn btn-whatsapp" type="button">
                <span aria-hidden="true">💬</span>
                <span data-i18n="btn_whatsapp">Share on WhatsApp</span>
              </button>
              <button id="btn-print" class="action-pill-btn btn-print" type="button">
                <span aria-hidden="true">🖨️</span>
                <span data-i18n="btn_print">Print Prescription</span>
              </button>
            </div>

            <!-- Accessible Single-Row Scrollable Tablist -->
            <div class="protocol-tablist" role="tablist" aria-label="Treatment and pathology sections">
              <button class="proto-tab" id="tabbtn-organic" data-tab="tab-organic" type="button" role="tab" aria-selected="true" data-i18n="tab_organic">
                🌿 Organic &amp; Biocontrol
              </button>
              <button class="proto-tab" id="tabbtn-chemical" data-tab="tab-chemical" type="button" role="tab" aria-selected="false" data-i18n="tab_chemical">
                🧪 Chemical &amp; 15L Sprayer
              </button>
              <button class="proto-tab" id="tabbtn-phd" data-tab="tab-phd" type="button" role="tab" aria-selected="false" data-i18n="tab_phd">
                🔬 PhD Pathology Key
              </button>
              <button class="proto-tab" id="tabbtn-deficiency" data-tab="tab-deficiency" type="button" role="tab" aria-selected="false" data-i18n="tab_deficiency">
                🍂 Soil &amp; Nutrients
              </button>
              <button class="proto-tab" id="tabbtn-preventive" data-tab="tab-preventive" type="button" role="tab" aria-selected="false" data-i18n="tab_preventive">
                🛡️ Preventive Care
              </button>
            </div>

            <!-- Tab Panels -->
            <div id="tab-organic" class="tab-panel" role="tabpanel" aria-labelledby="tabbtn-organic" tabindex="0">
              <div class="tab-panel-inner">
                <h4 class="panel-section-heading" data-i18n="organic_header">Organic &amp; Biological Controls (IPM Standard)</h4>
                <div id="organic-remedies-list" class="cards-stack"></div>
              </div>
            </div>

            <div id="tab-chemical" class="tab-panel" role="tabpanel" aria-labelledby="tabbtn-chemical" hidden>
              <div class="tab-panel-inner">
                <div class="knapsack-callout">
                  <div class="knapsack-callout-title">
                    <span aria-hidden="true">⚡</span>
                    <span data-i18n="knapsack_box_title">Standard 15-Liter Knapsack Sprayer Pump Recipe</span>
                  </div>
                  <p id="knapsack-recipe-text" class="knapsack-callout-copy"></p>
                </div>
                <h4 class="panel-section-heading" style="margin-top: 16px;" data-i18n="chemical_header">Precision Chemical Sprays &amp; Intervals</h4>
                <div id="chemical-treatments-list" class="cards-stack"></div>
              </div>
            </div>

            <div id="tab-phd" class="tab-panel" role="tabpanel" aria-labelledby="tabbtn-phd" hidden>
              <div class="tab-panel-inner">
                <div class="phd-cards-stack">
                  <div class="phd-detail-card">
                    <div class="phd-card-label"><span aria-hidden="true">🏷️</span> <span data-i18n="phd_taxonomy_title">Taxonomic Classification &amp; Etiology</span></div>
                    <p id="phd-taxonomy-text" class="phd-card-copy"></p>
                  </div>
                  <div class="phd-detail-card">
                    <div class="phd-card-label"><span aria-hidden="true">🌦️</span> <span data-i18n="phd_epidemiology_title">Epidemiological Triggers &amp; Disease Cycle</span></div>
                    <p id="phd-epidemiology-text" class="phd-card-copy"></p>
                  </div>
                  <div class="phd-detail-card highlight-differential">
                    <div class="phd-card-label"><span aria-hidden="true">🔍</span> <span data-i18n="phd_differential_title">Differential Diagnosis &amp; Lookalike Key</span></div>
                    <p id="phd-differential-text" class="phd-card-copy"></p>
                  </div>
                  <div class="phd-detail-card highlight-icar">
                    <div class="phd-card-label"><span aria-hidden="true">🏛️</span> <span data-i18n="phd_icar_title">ICAR &amp; Agricultural University Guidelines</span></div>
                    <p id="phd-icar-text" class="phd-card-copy"></p>
                  </div>
                </div>
              </div>
            </div>

            <div id="tab-deficiency" class="tab-panel" role="tabpanel" aria-labelledby="tabbtn-deficiency" hidden>
              <div class="tab-panel-inner">
                <div id="deficiency-content" class="cards-stack"></div>
              </div>
            </div>

            <div id="tab-preventive" class="tab-panel" role="tabpanel" aria-labelledby="tabbtn-preventive" hidden>
              <div class="tab-panel-inner">
                <div id="preventive-list" class="cards-stack"></div>
              </div>
            </div>

            <!-- Foliar Spectral Breakdown -->
            <div class="glass-subpanel spectral-box">
              <h4 class="subpanel-heading" data-i18n="spectral_title">Foliar Color &amp; Tissue Breakdown</h4>
              <div class="spectral-track" aria-hidden="true">
                <div id="spectral-bar-green" class="spectral-fill green" style="width: 70%;"></div>
                <div id="spectral-bar-yellow" class="spectral-fill yellow" style="width: 20%;"></div>
                <div id="spectral-bar-brown" class="spectral-fill brown" style="width: 10%;"></div>
              </div>
              <dl class="spectral-stats-grid">
                <div class="spectral-stat-item">
                  <dt><span class="swatch green" aria-hidden="true"></span><span data-i18n="green_tissue">Healthy Green Tissue</span></dt>
                  <dd id="spectral-green">70%</dd>
                </div>
                <div class="spectral-stat-item">
                  <dt><span class="swatch yellow" aria-hidden="true"></span><span data-i18n="yellow_chlorosis">Yellow Chlorosis</span></dt>
                  <dd id="spectral-yellow">20%</dd>
                </div>
                <div class="spectral-stat-item">
                  <dt><span class="swatch brown" aria-hidden="true"></span><span data-i18n="brown_necrosis">Brown Necrotic Spots</span></dt>
                  <dd id="spectral-brown">10%</dd>
                </div>
              </dl>
            </div>

            <!-- Differential Diagnostic Distribution -->
            <div class="glass-subpanel alternatives-box">
              <h4 class="subpanel-heading" data-i18n="alt_distribution_title">Differential Diagnostic Confidence Distribution</h4>
              <div id="alternatives-container" class="alternatives-stack"></div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Floating Kisan AI Assistant Trigger -->
  <button id="floating-chat-btn" class="floating-advisor-btn" type="button" aria-label="Ask Kisan AI Advisor">
    <span aria-hidden="true">🌾</span>
    <span data-i18n="btn_ask_ai">Ask Kisan AI Advisor</span>
    <span class="live-indicator" aria-hidden="true"></span>
  </button>

  <!-- Native Modal Dialog for Kisan AI Agri-Advisor -->
  <dialog id="chat-modal" class="glass-chat-dialog" closedby="any" aria-labelledby="chat-modal-title">
    <div class="chat-dialog-shell">
      <div class="chat-dialog-header">
        <div class="advisor-profile">
          <div class="advisor-badge" aria-hidden="true">👨‍🌾</div>
          <div>
            <h1 id="chat-modal-title" class="advisor-name" data-i18n="chat_modal_title">Kisan Mitra Agri-Advisor</h1>
            <span class="advisor-meta" data-i18n="advisor_online">● Online • English &amp; हिन्दी Krishi Expert</span>
          </div>
        </div>
        <button id="chat-close" class="btn-dialog-close" type="button" aria-label="Close advisor dialog">✕</button>
      </div>

      <div class="chat-quick-bar">
        <button class="quick-chip" type="button" data-prompt="How to prepare 1% Bordeaux mixture?" data-i18n="chat_quick_1">
          1% Bordeaux mixture recipe?
        </button>
        <button class="quick-chip" type="button" data-prompt="What is the difference between Early Blight and Late Blight?" data-i18n="chat_quick_2">
          Early vs Late Blight difference?
        </button>
        <button class="quick-chip" type="button" data-prompt="What is the knapsack sprayer dosage for Mancozeb 75 WP?" data-i18n="chat_quick_4">
          15L pump dosage for Mancozeb?
        </button>
        <button class="quick-chip" type="button" data-prompt="Organic spray for tomato whitefly and leaf curl?" data-i18n="chat_quick_3">
          Whitefly organic spray?
        </button>
      </div>

      <div id="chat-messages" class="chat-messages-feed">
        <div class="chat-bubble bot-bubble">
          <span data-i18n="chat_welcome">
            Namaste! I am your Kisan AI Agricultural Advisor. Ask me anything about tomato or potato diseases, 1% Bordeaux mixture preparation, blight differentiation, or 15L sprayer pump dosages.
          </span>
        </div>
      </div>

      <form id="chat-form" class="chat-input-footer">
        <input type="text" id="chat-input" class="chat-field" autofocus placeholder="Ask a tomato or potato farming question..." data-i18n="chat_placeholder">
        <button id="chat-send" class="btn-primary-glass btn-send" type="submit" data-i18n="chat_send">Send</button>
      </form>
    </div>
  </dialog>

  <!-- Footer -->
  <footer class="glass-footer">
    <div class="container footer-inner">
      <div>
        <strong>Kisan Mitra (किसान मित्र)</strong> • <span data-i18n="footer_text">Empowering Tomato &amp; Potato Farmers with Computer Vision &amp; Plant Pathology</span>
      </div>
      <div class="footer-meta">
        <span>Meta DINOv2 ViT-B/14 • Node.js &amp; EJS</span>
      </div>
    </div>
  </footer>

  <!-- Client Scripts -->
  <script src="/static/js/i18n.js?v=6"></script>
  <script src="/static/js/voice.js?v=6"></script>
  <script src="/static/js/app.js?v=6"></script>
</body>
</html>
